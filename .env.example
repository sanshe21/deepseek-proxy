# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# DeepSeek API 地址（默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认使用的 DeepSeek 模型
DEEPSEEK_MODEL=deepseek-chat

# 视觉模型 API Key（必填，用于识图）
# 支持任何 OpenAI 兼容接口，推荐通义千问 VL
VISUAL_API_KEY=sk-your-visual-model-key-here

# 视觉模型 API 地址
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱 GLM-4V: https://open.bigmodel.cn/api/paas/v4
VISUAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉模型名称
# 通义千问: qwen-vl-plus 或 qwen-vl-max
# 智谱: glm-4v
VISUAL_MODEL=qwen-vl-plus

# 代理服务端口
PORT=3001

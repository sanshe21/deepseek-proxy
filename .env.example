# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# DeepSeek API 地址（默认官方）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认使用的 DeepSeek 模型
DEEPSEEK_MODEL=deepseek-chat

# 视觉模型 API Key（必填，用于识图）
# 豆包（火山引擎）: https://console.volcengine.com/ark
VISUAL_API_KEY=ark-your-doubao-key-here

# 视觉模型 API 地址
# 豆包（火山引擎）- OpenAI 兼容端点
VISUAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 视觉模型名称
# 豆包: doubao-seed-2-0-lite-260428
VISUAL_MODEL=doubao-seed-2-0-lite-260428

# 代理服务端口
PORT=3001
